# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=fast_food_shop

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=fast-food-shop
JWT_AUDIENCE=fast-food-shop-users

# App Configuration
PORT=3000
NODE_ENV=development
APP_NAME=Fast Food Shop API
APP_VERSION=1.0.0
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
API_PREFIX=api/v1
PASSWORD_RESET_LINK_TARGET=api # api | frontend

# Security Configuration
BCRYPT_SALT_ROUNDS=10
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=32

# CORS Configuration
CORS_ORIGIN=*
CORS_CREDENTIALS=true

# SMTP Configuration for email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password_or_app_password
MAIL_FROM="Fast Food Shop <no-reply@fastfoodshop.local>"

# Password reset settings
RESET_TOKEN_TTL_MINUTES=20
RESET_THROTTLE_MINUTES=2
